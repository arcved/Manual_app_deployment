# Copy this file to ".env" and edit the values. Never commit ".env".

# Where MongoDB is listening. This default works for a local install
# or a Docker container that publishes port 27017.
MONGO_URI=mongodb://localhost:27017

# Name of the database the app will use (created automatically on first write).
MONGO_DB_NAME=task_manager

# Optional settings for the Flask development server
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_DEBUG=1
